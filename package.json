{
  "name": "ecotwin-x",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspaces --if-present",
    "dev:web": "npm run dev -w @ecotwin/web",
    "dev:api": "npm run start:dev -w @ecotwin/api",
    "dev:ai": "cd apps/ai-service && ..\\..\\.venv\\Scripts\\python -m uvicorn main:app --reload --port 8000"
  }
}
